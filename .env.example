POSTGRES_USER=liteseal
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://liteseal:replace-with-a-long-random-password@postgres:5432/liteseal
LITESEAL_BIND=0.0.0.0:3000
LITESEAL_CORS_ALLOW_ORIGIN=http://localhost:1420
LITESEAL_BOOTSTRAP_INVITE_CODE=replace-with-a-single-use-random-invite
RUST_LOG=info,tower_http=info,liteseal_server=debug

# Local development values:
# DATABASE_URL=postgres://liteseal:<password>@127.0.0.1:5432/liteseal
# LITESEAL_CORS_ALLOW_ORIGIN=http://localhost:1420
