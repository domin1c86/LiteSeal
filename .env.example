DATABASE_URL=postgres://liteseal:liteseal@postgres:5432/liteseal
LITESEAL_BIND=0.0.0.0:3000
LITESEAL_CORS_ALLOW_ORIGIN=http://localhost:1420
RUST_LOG=info,tower_http=info,liteseal_server=debug

# Local development values:
# DATABASE_URL=postgres://liteseal:liteseal@localhost:5432/liteseal
# LITESEAL_CORS_ALLOW_ORIGIN=http://localhost:1420

# Reusable local test invitations; comma-separated, case-sensitive.
LITESEAL_INVITE_CODES=LITESEAL-WIN-ALPHA,LITESEAL-WIN-BRAVO,LITESEAL-WIN-CHARLIE

# Optional T23 authorization control plane; no second-device messaging/login yet.
# Use the exact public canonical origin (without path or trailing slash).
# LITESEAL_DEVICE_AUTHORIZATION_ORIGIN=https://relay.example
